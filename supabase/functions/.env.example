# Edge Function secrets for local `npm run functions:serve`. Copy to supabase/functions/.env.
# In production set them with: npx supabase secrets set SITE_URL=https://your-domain ALLOWED_ORIGIN=https://your-domain
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
SITE_URL=http://localhost:5173
ALLOWED_ORIGIN=*
