{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbookpro/Documents/Projects/plotline-site/.codex/hooks/guard.mjs'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbookpro/Documents/Projects/plotline-site/.codex/hooks/verify-gate.mjs'",
            "timeout": 300,
            "statusMessage": "Running fast checks (typecheck, lint, unit tests)…"
          }
        ]
      }
    ]
  }
}
